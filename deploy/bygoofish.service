[Unit]
Description=ByGoofish service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/bygoofish
ExecStart=/opt/bygoofish/.venv/bin/python -u Start.py
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8080
Environment=WEB_CONCURRENCY=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SQL_LOG_ENABLED=false
EnvironmentFile=-/etc/bygoofish.env
User=bygoofish
Group=bygoofish
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
